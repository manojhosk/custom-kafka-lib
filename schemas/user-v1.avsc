{
  "type": "record",
  "name": "User",
  "namespace": "com.example.kafka.examples",
  "doc": "Example User entity schema - Version 1",
  "fields": [
    {
      "name": "id",
      "type": "string",
      "doc": "Unique user identifier"
    },
    {
      "name": "email",
      "type": "string",
      "doc": "User email address"
    },
    {
      "name": "name",
      "type": "string",
      "doc": "User full name"
    },
    {
      "name": "createdAt",
      "type": "long",
      "doc": "Timestamp when user was created (epoch millis)"
    }
  ]
}

